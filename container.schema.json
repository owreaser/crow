{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z0-9]+$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": { "anyOf": [
          { "enum": [false] },
          { "type": "string" }
        ]},

        "image": { "anyOf": [
          { "enum": [false] },
          { "type": "string" }
        ]},

        "dns_override": { "type": "boolean" },
        "git_pull": { "type": "boolean" },

        "port": {
          "anyOf": [{
            "type": "number",
            "minimum": 1,
            "maximum": 65535
          }, {
            "type": "string"
          }, {
            "type": "string",
            "enum": ["host"]
          }, {
            "type": "array",
            "items": {
              "anyOf": [{
                "type": "number",
                "minimum": 1,
                "maximum": 65535
              }, {
                "type": "string"
              }]
            }
          }, {
            "type": "null"
          }]
        },

        "dirs": {
          "type": "object",
          "patternProperties": {
            ".+": { "type": "string" }
          }
        },

        "nginx": {
          "type": "object",
          "required": ["host"],
          "additionalProperties": false,

          "properties": {
            "host": { "type": "string" },
            "http": { "type": "boolean" },
            "https": { "type": "boolean" },
            "ssl_conf": { "type": "string" },

            "port": {
              "type": "number",
              "minimum": 1,
              "maximum": 65535
            },

            "static": {
              "type": "object",
              "patternProperties": {
                ".+": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
